## Optional (legacy / experiments)
# Some older demo components in this repo use Mapbox GL. The main SunnyviewExperience flow
# does not require Mapbox.
# NEXT_PUBLIC_MAPBOX_TOKEN=

## Optional: external CV segmentation service
# If set, `POST /api/segment` will forward the request to this service.
# SEGMENT_SERVICE_URL=http://localhost:8000

## Optional: Gemini (panel brand recommendation)
# Used by `POST /api/panel-recommend`.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

## Optional: external backend origin (save/share/AI endpoints)
# NEXT_PUBLIC_API_ORIGIN=http://localhost:3001
